{
  "components": {
    "schemas": {
      "AITaskRequest": {
        "additionalProperties": false,
        "properties": {
          "input_manifest": {
            "$ref": "#/components/schemas/ApprovedInputManifest"
          },
          "model_manifest_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Model Manifest Digest",
            "type": "string"
          },
          "operation_key": {
            "format": "uuid",
            "title": "Operation Key",
            "type": "string"
          },
          "owned_input_handle": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Owned Input Handle",
            "type": "string"
          },
          "rule_version": {
            "title": "Rule Version",
            "type": "string"
          },
          "template_version": {
            "title": "Template Version",
            "type": "string"
          }
        },
        "required": [
          "input_manifest",
          "owned_input_handle",
          "model_manifest_digest",
          "rule_version",
          "template_version",
          "operation_key"
        ],
        "title": "AITaskRequest",
        "type": "object"
      },
      "AITaskStatus": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "processed_chunks": {
            "minimum": 0.0,
            "title": "Processed Chunks",
            "type": "integer"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "completed",
              "cancelled",
              "failed"
            ],
            "title": "State",
            "type": "string"
          },
          "task_id": {
            "format": "uuid",
            "title": "Task Id",
            "type": "string"
          },
          "total_chunks": {
            "minimum": 0.0,
            "title": "Total Chunks",
            "type": "integer"
          }
        },
        "required": [
          "task_id",
          "state",
          "processed_chunks",
          "total_chunks",
          "code"
        ],
        "title": "AITaskStatus",
        "type": "object"
      },
      "ApprovedInputManifest": {
        "additionalProperties": false,
        "properties": {
          "application_revision": {
            "format": "uuid",
            "title": "Application Revision",
            "type": "string"
          },
          "consent_version": {
            "title": "Consent Version",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceReference"
            },
            "title": "Evidence",
            "type": "array"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "jd_version": {
            "format": "uuid",
            "title": "Jd Version",
            "type": "string"
          },
          "manifest_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Manifest Digest",
            "type": "string"
          },
          "manifest_id": {
            "format": "uuid",
            "title": "Manifest Id",
            "type": "string"
          },
          "opaque_input_handle": {
            "title": "Opaque Input Handle",
            "type": "string"
          },
          "person_id": {
            "format": "uuid",
            "title": "Person Id",
            "type": "string"
          },
          "privacy_epoch": {
            "format": "uuid",
            "title": "Privacy Epoch",
            "type": "string"
          },
          "profile_revision": {
            "format": "uuid",
            "title": "Profile Revision",
            "type": "string"
          },
          "purpose_version": {
            "title": "Purpose Version",
            "type": "string"
          },
          "realm_key": {
            "title": "Realm Key",
            "type": "string"
          }
        },
        "required": [
          "manifest_id",
          "realm_key",
          "person_id",
          "privacy_epoch",
          "purpose_version",
          "consent_version",
          "application_revision",
          "profile_revision",
          "jd_version",
          "evidence",
          "opaque_input_handle",
          "expires_at",
          "manifest_digest"
        ],
        "title": "ApprovedInputManifest",
        "type": "object"
      },
      "EvidenceReference": {
        "additionalProperties": false,
        "properties": {
          "content_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Content Digest",
            "type": "string"
          },
          "document_version": {
            "format": "uuid",
            "title": "Document Version",
            "type": "string"
          },
          "end": {
            "minimum": 0.0,
            "title": "End",
            "type": "integer"
          },
          "page": {
            "minimum": 1.0,
            "title": "Page",
            "type": "integer"
          },
          "start": {
            "minimum": 0.0,
            "title": "Start",
            "type": "integer"
          }
        },
        "required": [
          "document_version",
          "page",
          "start",
          "end",
          "content_digest"
        ],
        "title": "EvidenceReference",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SafeError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "SafeError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Windows local AI contract",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ai/tasks": {
      "post": {
        "operationId": "submitLocalAITask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AITaskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AITaskStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafeError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Submit",
        "tags": [
          "local-ai"
        ]
      }
    },
    "/ai/tasks/{task_id}": {
      "get": {
        "operationId": "localAITaskStatus",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Task Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AITaskStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafeError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Status",
        "tags": [
          "local-ai"
        ]
      }
    },
    "/ai/tasks/{task_id}/cancel": {
      "post": {
        "operationId": "cancelLocalAITask",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Task Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AITaskStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafeError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Cancel",
        "tags": [
          "local-ai"
        ]
      }
    }
  }
}
