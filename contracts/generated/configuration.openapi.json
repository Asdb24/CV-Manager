{
  "components": {
    "schemas": {
      "ClientConfiguration": {
        "additionalProperties": false,
        "properties": {
          "api_origin": {
            "title": "Api Origin",
            "type": "string"
          },
          "desktop_host": {
            "title": "Desktop Host",
            "type": "string"
          },
          "desktop_origin": {
            "title": "Desktop Origin",
            "type": "string"
          },
          "desktop_port": {
            "title": "Desktop Port",
            "type": "integer"
          },
          "execution_mode": {
            "enum": [
              "standalone",
              "connected"
            ],
            "title": "Execution Mode",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "realm_key": {
            "title": "Realm Key",
            "type": "string"
          },
          "release_kind": {
            "anyOf": [
              {
                "enum": [
                  "installed",
                  "portable"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Kind"
          },
          "request_timeout_ms": {
            "title": "Request Timeout Ms",
            "type": "integer"
          },
          "web_host": {
            "title": "Web Host",
            "type": "string"
          },
          "web_origin": {
            "title": "Web Origin",
            "type": "string"
          },
          "web_port": {
            "title": "Web Port",
            "type": "integer"
          }
        },
        "required": [
          "profile",
          "execution_mode",
          "realm_key",
          "api_origin",
          "desktop_origin",
          "web_origin",
          "desktop_host",
          "desktop_port",
          "web_host",
          "web_port",
          "request_timeout_ms",
          "release_kind"
        ],
        "title": "ClientConfiguration",
        "type": "object"
      },
      "Profile": {
        "enum": [
          "development",
          "test",
          "standalone",
          "server",
          "connected"
        ],
        "title": "Profile",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Agency CV API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/contracts/client-configuration": {
      "get": {
        "operationId": "clientConfigurationContract",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientConfiguration"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Config Contract",
        "tags": [
          "contract"
        ]
      }
    }
  }
}
