{
  "components": {
    "schemas": {
      "ApplicationContact": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          }
        },
        "required": [
          "name",
          "email",
          "phone"
        ],
        "title": "ApplicationContact",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobProjection": {
        "additionalProperties": false,
        "properties": {
          "agency_display_name": {
            "title": "Agency Display Name",
            "type": "string"
          },
          "application_instructions": {
            "title": "Application Instructions",
            "type": "string"
          },
          "application_open": {
            "title": "Application Open",
            "type": "boolean"
          },
          "company_display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Display Name"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "employment_type": {
            "title": "Employment Type",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "location": {
            "title": "Location",
            "type": "string"
          },
          "publication_id": {
            "format": "uuid",
            "title": "Publication Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "work_arrangement": {
            "title": "Work Arrangement",
            "type": "string"
          }
        },
        "required": [
          "publication_id",
          "agency_display_name",
          "company_display_name",
          "title",
          "location",
          "work_arrangement",
          "employment_type",
          "description",
          "application_instructions",
          "application_open",
          "expires_at"
        ],
        "title": "JobProjection",
        "type": "object"
      },
      "PublicCapabilities": {
        "additionalProperties": false,
        "properties": {
          "applications": {
            "const": "unavailable",
            "title": "Applications",
            "type": "string"
          },
          "code": {
            "const": "PUBLIC_FEATURES_NOT_IMPLEMENTED",
            "title": "Code",
            "type": "string"
          },
          "jobs": {
            "const": "unavailable",
            "title": "Jobs",
            "type": "string"
          }
        },
        "required": [
          "jobs",
          "applications",
          "code"
        ],
        "title": "PublicCapabilities",
        "type": "object"
      },
      "PublicSubmissionContract": {
        "additionalProperties": false,
        "properties": {
          "consent": {
            "$ref": "#/components/schemas/PurposeConsent"
          },
          "contact": {
            "$ref": "#/components/schemas/ApplicationContact"
          },
          "publication_id": {
            "format": "uuid",
            "title": "Publication Id",
            "type": "string"
          },
          "upload_intent_handle": {
            "title": "Upload Intent Handle",
            "type": "string"
          }
        },
        "required": [
          "publication_id",
          "contact",
          "consent",
          "upload_intent_handle"
        ],
        "title": "PublicSubmissionContract",
        "type": "object"
      },
      "PurposeConsent": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "const": true,
            "title": "Accepted",
            "type": "boolean"
          },
          "policy_version": {
            "title": "Policy Version",
            "type": "string"
          },
          "purpose_version": {
            "title": "Purpose Version",
            "type": "string"
          }
        },
        "required": [
          "policy_version",
          "purpose_version",
          "accepted"
        ],
        "title": "PurposeConsent",
        "type": "object"
      },
      "SafeError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "SafeError",
        "type": "object"
      },
      "SubmissionReceipt": {
        "additionalProperties": false,
        "properties": {
          "receipt": {
            "title": "Receipt",
            "type": "string"
          },
          "status": {
            "const": "accepted_for_review",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "receipt",
          "status"
        ],
        "title": "SubmissionReceipt",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Agency CV API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/public/applications": {
      "post": {
        "operationId": "publicApplication",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicSubmissionContract"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionReceipt"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafeError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Public Application",
        "tags": [
          "public"
        ]
      }
    },
    "/public/capabilities": {
      "get": {
        "operationId": "publicCapabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicCapabilities"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Public Capabilities",
        "tags": [
          "public"
        ]
      }
    },
    "/public/jobs": {
      "get": {
        "operationId": "publicJobs",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/JobProjection"
                  },
                  "title": "Response Publicjobs",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafeError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Public Jobs",
        "tags": [
          "public"
        ]
      }
    }
  }
}
